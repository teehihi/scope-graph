# ScopeGraph Environment Configuration

# Service Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Configuration
DATABASE_URL=postgresql+psycopg://scopegraph:scopegraph_dev_secret@localhost:5432/scopegraph_db
# For Docker Compose, DATABASE_URL inside containers is:
# DATABASE_URL=postgresql+psycopg://scopegraph:scopegraph_dev_secret@postgres:5432/scopegraph_db

# Redis Configuration (Job Queue & Cache)
REDIS_URL=redis://localhost:6379/0
# For Docker Compose, REDIS_URL inside containers is:
# REDIS_URL=redis://redis:6379/0

# Workspace & File Limits
WORKSPACE_DIR=./data/workspaces
MAX_UPLOAD_SIZE_MB=25
MAX_EXTRACTED_SIZE_MB=100
MAX_FILE_COUNT=500
MAX_FILE_SIZE_KB=500

# ==============================================================================
# Meta AI Multi-Provider Configuration (Hackathon $350 Architecture)
# ==============================================================================

# 1. Official Meta Model API ($150 Hackathon Credit) -> Deep Reasoning & Implementation Brief
META_OFFICIAL_API_KEY=your_meta_official_api_key_here
META_OFFICIAL_BASE_URL=https://api.meta.ai/v1
META_OFFICIAL_MODEL=muse-spark-1.3

# 2. Modal Serverless Auto Endpoint ($100 Modal Credit) -> Fast Intent Parsing
MODAL_API_KEY=wk-...ws-...
MODAL_BASE_URL=https://<workspace>--<endpoint-name>.us-west.modal.direct/v1
MODAL_MODEL=meta-models/Muse-Spark-Open-816B-A42B

# 3. Baseten Inference ($100 Baseten Credit) -> UI Vision & Reflection Review
BASETEN_API_KEY=your_baseten_api_key_here
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Active / Default Fallback Provider
# Options: meta_model_api, fireworks, baseten, modal, together, groq, generic_openai_compat, offline_demo
META_AI_PROVIDER=offline_demo
META_AI_API_KEY=
META_AI_BASE_URL=https://api.meta.ai/v1
META_AI_MODEL=muse-spark-1.3
# Retrieval is deterministic and bounds the context sent to the inference provider.
AI_RETRIEVAL_TOP_K=8
AI_CONTEXT_TOKEN_BUDGET=3000
META_AI_TEMPERATURE=0.1
META_AI_MAX_TOKENS=6000

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback/github

# Frontend Configuration (for apps/web)
VITE_API_URL=http://localhost:8000
VITE_GITHUB_CLIENT_ID=

