# ScopeGraph Environment Configuration

# Service Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Configuration
DATABASE_URL=postgresql+psycopg://scopegraph:scopegraph_dev_secret@localhost:5432/scopegraph_db
# For Docker Compose, DATABASE_URL inside containers is:
# DATABASE_URL=postgresql+psycopg://scopegraph:scopegraph_dev_secret@postgres:5432/scopegraph_db

# Redis Configuration (Job Queue & Cache)
REDIS_URL=redis://localhost:6379/0
# For Docker Compose, REDIS_URL inside containers is:
# REDIS_URL=redis://redis:6379/0

# Workspace & File Limits
WORKSPACE_DIR=./data/workspaces
MAX_UPLOAD_SIZE_MB=25
MAX_EXTRACTED_SIZE_MB=100
MAX_FILE_COUNT=500
MAX_FILE_SIZE_KB=500

# Inference defaults to the offline demo. A remote Meta provider requires
# META_AI_PROVIDER and META_AI_API_KEY plus an approved deployment endpoint.
# Options: meta_model_api, fireworks, baseten, modal, together, groq, generic_openai_compat, offline_demo
META_AI_PROVIDER=offline_demo
META_AI_API_KEY=
META_AI_BASE_URL=https://api.meta.ai/v1
META_AI_MODEL=muse-spark-1.3
# Local stage routing can be enabled after configuring all providers. Production
# enables Multi-AI automatically and requires the same provider configuration.
AI_PROVIDER_PROFILE=meta_only
BASETEN_VISION_BASE_URL=
BASETEN_VISION_MODEL=
BASETEN_VISION_API_KEY=
BASETEN_VISION_CAPABLE=false
MODAL_REASONING_BASE_URL=
MODAL_REASONING_MODEL=
MODAL_REASONING_API_KEY=
# Retrieval is deterministic and bounds the context sent to the inference provider.
AI_RETRIEVAL_TOP_K=8
AI_CONTEXT_TOKEN_BUDGET=3000
META_AI_TEMPERATURE=0.1
META_AI_MAX_TOKENS=6000

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://scopegraph.vercel.app/auth/callback/github

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://scopegraph.vercel.app/auth/callback/google

# Frontend Configuration (for apps/web)
VITE_API_URL=http://localhost:8000
VITE_GITHUB_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
VITE_STRIPE_PUBLISHABLE_KEY=

# Stripe Billing Configuration
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRODUCT_PLUS=prod_VYfLUY5c7cyCC1
STRIPE_PRODUCT_PRO=prod_VYfMFqbyB9dPy4
STRIPE_WEBHOOK_SECRET=

# ==============================================================================
# SMTP Email Configuration (for OTP verification)
# ==============================================================================
# Option A — Gmail App Password (free, easy)
# Setup: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ScopeGraph <your-email@gmail.com>
SMTP_USE_TLS=true

# Option B — Resend (recommended, free 3000 emails/month)
# Setup: https://resend.com/api-keys
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_xxxxxxxxxxxxxxxx
# SMTP_FROM=ScopeGraph <onboarding@yourdomain.com>
# SMTP_USE_TLS=true

# Auth JWT
SECRET_KEY=change-me-to-a-random-64-char-string-in-production
