# ScopeGraph Environment Configuration

# Service Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Configuration
DATABASE_URL=postgresql+psycopg://scopegraph:scopegraph_dev_secret@localhost:5432/scopegraph_db
# For Docker Compose, DATABASE_URL inside containers is:
# DATABASE_URL=postgresql+psycopg://scopegraph:scopegraph_dev_secret@postgres:5432/scopegraph_db

# Redis Configuration (Job Queue & Cache)
REDIS_URL=redis://localhost:6379/0
# For Docker Compose, REDIS_URL inside containers is:
# REDIS_URL=redis://redis:6379/0

# Workspace & File Limits
WORKSPACE_DIR=./data/workspaces
MAX_UPLOAD_SIZE_MB=25
MAX_EXTRACTED_SIZE_MB=100
MAX_FILE_COUNT=500
MAX_FILE_SIZE_KB=500

# Meta AI / Inference Configuration
# Provider options: meta_model_api, fireworks, baseten, modal, together, groq, generic_openai_compat, offline_demo
META_AI_PROVIDER=offline_demo
META_AI_API_KEY=
META_AI_BASE_URL=https://api.meta.com/v1
META_AI_MODEL=meta-llama/Llama-3.3-70B-Instruct
META_AI_TEMPERATURE=0.1
META_AI_MAX_TOKENS=3000

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback/github

# Frontend Configuration (for apps/web)
VITE_API_URL=http://localhost:8000
VITE_GITHUB_CLIENT_ID=

